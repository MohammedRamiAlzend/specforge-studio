# SMTP settings required by the API at startup (auth OTP + password recovery).
# Copy this file to backend/.env and fill in your real values.
#
# Gmail setup (2 minutes):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password (16 characters):
#      https://myaccount.google.com/apppasswords
#   3. Paste it below as SMTP_PASS (spaces optional).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=abcdefghijklmnop
SMTP_FROM=your.address@gmail.com

# Local server / database defaults (usually no change needed)
# Keep this true outside trusted fixture tooling. Production startup rejects false.
AUTH_REQUIRED=true
# Set true when serving over HTTPS. Production startup rejects false.
COOKIE_SECURE=false
# Required exact frontend origin for split-origin deployments in production.
# CORS_ORIGIN=https://studio.example.com
AUTH_RATE_LIMIT_ENABLED=true
PORT=3000
DATABASE_PATH=data/specforge.db
BACKUP_STATUS_FILE=backups/last-backup.json

# Comma-separated exact email addresses granted global admin access.
# Production startup rejects an empty value.
# ADMIN_EMAILS=admin@specforge.com
# New registrations are accepted only for this domain or its subdomains.
TRUSTED_SIGNUP_DOMAINS=specforge.com
# 64 hex characters (32 bytes), generated and stored in the production secret manager.
# LEONA_CREDENTIAL_KEY=replace-with-64-hex-characters

# Explicitly seed the local/operator administrator; never expose this password in production config.
# From the repository root: bun run --cwd backend seed-admin
# SEED_ADMIN_EMAIL=admin@specforge.com
# SEED_ADMIN_PASSWORD=change-this-before-production
